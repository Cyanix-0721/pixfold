<?xml version="1.0" encoding="utf-8"?>
<!--
  Workflow B · empty workspace strings (English, default / fallback).

  Deliberately its own file instead of joining `strings_workflowb.xml`: this key only
  exists because a scanned workspace can legitimately contain zero comic volumes
  (no images at all, or every image sitting loose in the workspace root), and the
  metadata page has to say so instead of crashing on `volumes.first()`.

  ⚠️ Keep in sync with `values-zh/strings_workflowb_empty.xml` — a key present on only
  one side hard-fails lint (`MissingTranslation` / `ExtraTranslation`) under
  `warningsAsErrors = true`.
-->
<resources>

    <!-- Two sentences on purpose: the first states the fact, the second says what to do
         about it. Do not shrink this into a single "no volumes" label — the user needs
         the next action, not just the diagnosis. -->
    <string name="b_meta_empty">This workspace has no comic volumes to edit.\nPick a folder that contains image folders, or add images in your file manager and try again.</string>

    <!-- Step 1 (library list). Short on purpose: the workspace bar right above it already
         carries the "pick another folder" action, so repeating the instruction here would
         push the user to look in two places for the same button. -->
    <string name="b_library_empty">No comic volumes found yet.\nEach folder that directly contains images becomes one volume.</string>

    <!-- Step 3 (pack preview). Kept separate from `b_meta_empty` even though the cause is
         the same: this step is about packing, so "nothing to pack" is the honest wording.
         Reusing the edit-page string would tell a user looking at the pack step that there
         is nothing to *edit*, which reads like a bug. -->
    <string name="b_pack_empty">This workspace has no comic volumes to pack.\nPick a folder that contains image folders, or add images in your file manager and try again.</string>

    <!-- Execution blocked (D2b). Both take formatted byte counts — never bare byte numbers,
         because "1048576" tells the user nothing actionable. -->
    <string name="pack_error_space">Not enough free space: short by %1$s (%2$s available).</string>

    <!-- Output name collision (2026-10-19, found on device: two volumes of the same series
         both packed into one file — the report said "succeeded 2" while the disk had 1).
         Plural on the volume count: `%1$d` decides the form, so it must stay the first
         placeholder. `%2$s` is the conflicting path, shown verbatim so the user can go
         change that volume's metadata. -->
    <plurals name="pack_error_collision">
        <item quantity="one">%1$d volume writes to the same file: %2$s</item>
        <item quantity="other">%1$d volumes write to the same file: %2$s</item>
    </plurals>

    <string name="pack_error_collision_hint">Change the CBZ name of one of them in step 2, then try again.</string>

    <string name="pack_error_unknown">Packing was blocked for an unknown reason. Please report this.</string>

</resources>
