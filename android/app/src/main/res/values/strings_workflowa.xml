<?xml version="1.0" encoding="utf-8"?>
<!--
  Workflow A screen strings (English, default / fallback).

  ⚠️ Keep in sync with `values-zh/strings_workflowa.xml` — a key missing on either side
  makes lint's `MissingTranslation` / `ExtraTranslation` hard-fail under
  `warningsAsErrors = true`. Entries marked `translatable="false"` do not appear in the
  Chinese file.

  Naming: `a_sort_*` = step 1 sort-rule editor, `a_*` = step 1/2/3 pages,
  `a_step_*` = the workflow A step container.
-->
