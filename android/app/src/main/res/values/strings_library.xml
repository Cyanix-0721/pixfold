<?xml version="1.0" encoding="utf-8"?>
<!--
  Workflow B screen strings (English, default / fallback).

  ⚠️ Keep in sync with `values-zh/strings_library.xml` — a key missing on either side
  makes lint's `MissingTranslation` / `ExtraTranslation` hard-fail under
  `warningsAsErrors = true`. Entries marked `translatable="false"` do not appear in the
  Chinese file.

  Naming: `meta_*` = step 2 metadata page, `pack_*` = step 3 package preview,
  `lib_*` = step 1 library page, `b_*` = the workflow B step container.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Step container (LibrarySteps) ============ -->
    <string name="b_step_back">← Back</string>
    <string name="b_step_back_cd">Back</string>
    <string name="b_step_label_library">Library</string>
    <string name="b_step_label_metadata">Metadata</string>
    <string name="b_step_label_pack">Package</string>

    <!-- ============ Step 2 · metadata (MetadataPage) ============ -->
    <string name="meta_suggestion_with_source">%1$s (%2$s)</string>
    <string name="meta_suggestion_prefix">Suggested: %1$s</string>
    <string name="meta_no_value">none</string>
    <string name="meta_writer_clean">Clean up</string>
    <string name="meta_writer_clean_cd">Clean up writer automatically</string>
    <string name="meta_writer_cleaned_hint">Cleaned suggestion: %1$s (%2$s)</string>
    <string name="meta_cbz_name_hint">Will be: %1$s</string>
    <string name="meta_output_dir_hint">Suggested output folder (%1$s)</string>
    <plurals name="meta_batch_applied">
        <item quantity="one">Applied to %1$d volume</item>
        <item quantity="other">Applied to %1$d volumes</item>
    </plurals>
    <plurals name="meta_batch_applied_skipped">
        <item quantity="one">Applied to %1$d volume (skipped %2$d with per-item overrides)</item>
        <item quantity="other">Applied to %1$d volumes (skipped %2$d with per-item overrides)</item>
    </plurals>
    <string name="meta_volume_chip_cd">Volume %1$s</string>
    <!-- 1 级「系列」芯片(2026-10-19 卷芯片改两级后新增):%1$s = 系列名,%2$d = 系列内卷数。 -->
    <string name="meta_series_chip">%1$s (%2$d)</string>
    <string name="meta_series_cd">Series %1$s</string>
        <string name="meta_include_cd">Include volume %1$s</string>
    <plurals name="meta_volume_status">
        <item quantity="one">Included · %1$d page · %2$d fields overridden</item>
        <item quantity="other">Included · %1$d pages · %2$d fields overridden</item>
    </plurals>
    <string name="meta_output_conflict">Output conflict: a CBZ of the same name already exists in the output folder (%1$s)</string>
    <string name="meta_pending_prefix">To confirm:\u0020</string>
    <string name="meta_reset">Use suggestion</string>
    <string name="meta_reset_cd">Use suggested value for %1$s</string>
    <string name="meta_lang_unset_error">Language is unset and must be confirmed</string>
    <string name="meta_lang_code_label" tools:ignore="TypographyDashes">ISO 639-1 code</string>
    <string name="meta_batch_title">Batch set (skips manually edited fields)</string>
    <string name="meta_batch_field_cd">Batch field %1$s</string>
    <string name="meta_batch_value_label">Batch value</string>
    <string name="meta_batch_apply">Apply</string>
    <string name="meta_batch_apply_cd">Apply batch setting</string>
    <string name="meta_batch_force_on">Override per-item exceptions</string>
    <string name="meta_batch_force_off">Respect per-item exceptions</string>
    <string name="meta_batch_force_cd">Override per-item exceptions</string>
    <string name="meta_next">Next: package plan</string>
    <string name="meta_next_cd">Next: package plan</string>

    <!-- ============ Step 1 · comics library (LibraryPage) ============ -->
    <string name="lib_root">Library: %1$s</string>
    <plurals name="lib_summary">
        <item quantity="one">%1$d series / %2$d volumes · %3$d selected · %4$d to confirm</item>
        <item quantity="other">%1$d series / %2$d volumes · %3$d selected · %4$d to confirm</item>
    </plurals>
    <plurals name="lib_series_volume_count">
        <item quantity="one">%1$d volume</item>
        <item quantity="other">%1$d volumes</item>
    </plurals>
    <string name="lib_series_pending">%1$d to confirm</string>
    <string name="lib_volume_cd">Volume %1$s%2$s</string>
    <string name="lib_volume_cd_selected">\u0020(currently selected)</string>
    <string name="lib_include_cd">Include volume %1$s</string>
    <string name="lib_volume_current">\u0020· current</string>
    <plurals name="lib_volume_suggestion">
        <item quantity="one">%1$d page · suggested Title "%2$s" (%3$s)</item>
        <item quantity="other">%1$d pages · suggested Title "%2$s" (%3$s)</item>
    </plurals>
    <string name="lib_issue_separator">\u0020/\u0020</string>
    <string name="lib_output_conflict">Output conflict</string>
    <string name="lib_next">Next: edit metadata</string>
    <string name="lib_next_cd">Next: edit metadata</string>

    <!-- ============ Step 3 · package preview (PackPreviewPage) ============ -->
    <string name="pack_volume_chip_cd">Preview volume %1$s</string>
    <string name="pack_volume_excluded">%1$s (excluded)</string>
    <string name="pack_xml_title">ComicInfo.xml preview</string>
    <plurals name="pack_page_header">
        <item quantity="one">Page preview (renumbered in the current order, %1$d item)</item>
        <item quantity="other">Page preview (renumbered in the current order, %1$d items)</item>
    </plurals>
    <string name="pack_page_hint">(Numbers start at 001 and extensions are lowercased; pages marked "Manually adjusted" were dragged)</string>
    <string name="pack_page_issues">Page numbers do not match the page order: %1$s</string>
    <string name="pack_page_issue_separator">;\u0020</string>
    <string name="pack_page_manual">Manually adjusted</string>
    <string name="pack_plan_title">Execution plan</string>
    <string name="pack_conflict_policy_title">Output conflict policy</string>
    <string name="pack_source_policy_title">Source folder handling</string>
    <string name="pack_clean_empty_on">Clean empty folders: on (dangerous)</string>
    <string name="pack_clean_empty_off">Clean empty folders: off (default)</string>
    <string name="pack_delete_warning">Source folder deletion is selected: needs a separate confirmation before running</string>
    <string name="pack_confirm">Confirm package</string>
    <string name="pack_confirm_cd">Confirm package</string>
    <string name="pack_output">Output: %1$s</string>
    <string name="pack_output_exists">\u0020(a file with the same name already exists)</string>
    <string name="pack_language_iso">LanguageISO: %1$s</string>
    <string name="pack_excluded_warning">This volume is excluded and will not be packaged (re-include it from the volume header in step 1 or 2)</string>
    <plurals name="pack_included_count">
        <item quantity="one">%1$d of %2$d volume will be packaged</item>
        <item quantity="other">%1$d of %2$d volumes will be packaged</item>
    </plurals>
    <string name="pack_included_count_hint">\u0020(excluded volumes are not packaged)</string>
    <string name="pack_lang_other_empty">(no code entered, not written)</string>
    <string name="pack_lang_unset">Not written (language not confirmed)</string>
    <string name="pack_lang_unknown">Not written (unknown)</string>
    <string name="pack_lang_skip">Not written</string>

</resources>
