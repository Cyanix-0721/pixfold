<?xml version="1.0" encoding="utf-8"?>
<!--
  Domain-layer strings (English, default / fallback).

  These are the English renderings of the `domain/` module's `TextKey` entries. The
  domain layer itself only produces a key + arguments (see `domain/.../text/TextKey.kt`
  and `Msg.kt`); resolution happens at render time in the app layer.
  Naming rule: `domain_<area>_<semantics>`, one-to-one with the `TextKey` enum
  (see `ui/text/PixFoldText.kt`).

  ⚠️ English is the default (`values/`) and Chinese lives in `values-zh/`: until the user
  picks a language the app follows the system, so a device in any third language falls
  back to the strings below. (User decision 2026-09-25.)

  ⚠️ Maintenance: a new `TextKey` member must be added to BOTH this file and
  `values-zh/domain_strings.xml`, or lint `MissingTranslation` / `ExtraTranslation`
  hard-fails under `warningsAsErrors = true`.

  ⚠️ Plurals: entries marked as plural keys must be <plurals> in both files (a resource
  type may not differ per language). English writes both the `one` and `other` items;
  Chinese legitimately has only `other` (lint's `UnusedQuantity` rejects a `one` variant
  for language "zh").
-->
<resources
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Sort fields (SortField) ============ -->
    <string name="domain_sort_natural_name">File name (natural)</string>
    <string name="domain_sort_file_name">File name (lexical)</string>
    <string name="domain_sort_dir_name">Directory name</string>
    <string name="domain_sort_modified">Date modified</string>
    <string name="domain_sort_created">Date created</string>
    <string name="domain_sort_size">File size</string>

    <!-- ============ Name component kinds (NameComponentKind) ============ -->
    <string name="domain_name_kind_prefix">Custom prefix</string>
    <string name="domain_name_kind_root_dir">Root folder name</string>
    <string name="domain_name_kind_rel_dir">Relative folder segment</string>
    <string name="domain_name_kind_dir_index">Folder index</string>
    <string name="domain_name_kind_image_index">Image index</string>
    <string name="domain_name_kind_orig_name">Original file name</string>
    <string name="domain_name_kind_custom_text">Custom text</string>

    <!-- ============ Case policy (CasePolicy) ============ -->
    <string name="domain_case_policy_keep">Keep as is</string>
    <string name="domain_case_policy_lower">Lowercase</string>
    <string name="domain_case_policy_upper">Uppercase</string>

