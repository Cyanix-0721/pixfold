    <string name="domain_lang_zh">zh · Chinese</string>
    <string name="domain_lang_ja">ja · Japanese</string>
    <string name="domain_lang_other" tools:ignore="TypographyDashes">Other ISO 639-1</string>
    <string name="domain_lang_unknown">Unknown</string>
    <string name="domain_lang_skip">Do not write tag</string>

