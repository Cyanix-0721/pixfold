<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared strings (English, default / fallback). Naming follows `values/strings_plan.xml`.
-->
<resources>

    <!-- ============ Common actions ============ -->
    <string name="common_back">Back</string>
    <string name="common_close">Close</string>

    <!-- ============ 卷切换(工作流 B 步骤 2/3 共用 VolumeChipRow) ============ -->
    <plurals name="volume_all">
        <item quantity="one">All %1$d volume</item>
        <item quantity="other">All %1$d volumes</item>
    </plurals>

    <!--
      1 级「系列」行溢出时的「全部 N 项」入口(2026-10-19 卷芯片改两级后新增)。
      量词用「项」而不是「个系列」:1 级行既有系列又有单本卷,两者都算一项,
      「全部 12 项」比「全部 12 个系列」更贴实际(与 collection_all 同一口径)。
    -->
    <plurals name="volume_group_all">
        <item quantity="one">All %1$d item</item>
        <item quantity="other">All %1$d items</item>
    </plurals>

    <!--
      芯片行展开后的「收起」入口(2026-10-23 瀑布流改版新增)。
      与 volume_all / collection_all 同尺寸、同位置:展开后最后一块从「全部 N 项」
      原地变成「收起」,用户不需要移开手指去找另一个控件。
    -->
    <string name="chip_collapse">Show less</string>

    <!-- ============ 集合切换(工作流 A 步骤 1 的 CollectionChipRows) ============ -->
    <!--
      量词用「项」而不是「个集合」:1 级芯片里既有系列又有单本,两者都算一项,
      「全部 12 项」比「全部 12 个集合」更贴实际(系列本身也是集合的容器)。
    -->
    <plurals name="collection_all">
        <item quantity="one">All %1$d item</item>
        <item quantity="other">All %1$d items</item>
    </plurals>

    <!-- ============ Home screen (HomeScreen) ============ -->
    <string name="home_settings_cd">Settings</string>
    <!--
      Home card copy. User 2026-10-14: 「主要功能就是工作流AB，所以主页应该有2个大卡片显示，
      并且改下文案，直接叫工作流不好听」— the "Workflow A/B" prefix is gone on purpose.
      Resource names keep the `home_workflow_*` prefix so the ~30 existing navigation tests
      that locate the entries via `TestText.of(R.string.home_workflow_a)` keep working.
    -->
    <string name="home_workflow_a">Organize images</string>
    <string name="home_workflow_a_subtitle">Sort, rename and preview by your own rules</string>
    <string name="home_workflow_b">Pack comics</string>
    <string name="home_workflow_b_subtitle">Fill in metadata and pack volumes into CBZ</string>
    <!-- 2026-10-24(用户裁决 乙/甲/乙):未选工作区时两张大卡禁用,这一行说明为什么。 -->
    <string name="home_workspace_gate_hint">Demo data — pick a folder below to work on your own files</string>

    <!--
      ============ Reset all (ResetAllButton) ============
      User 2026-10-14: a single icon button at the right end of the step tab row,
      resetting the whole workflow (sort rule / manual order / naming overrides /
      metadata edits). Long press reveals `common_reset_all_hint`; tapping opens a
      confirmation (product constraint 5: destructive actions must be explained).
    -->
    <string name="common_reset_all_cd">Reset all adjustments</string>
    <string name="common_reset_all_hint">Reset all adjustments</string>
    <string name="common_reset_all_title">Reset all adjustments?</string>
    <string name="common_reset_all_body">Sort rules, manual adjustments, naming overrides and metadata edits will be cleared.</string>
    <string name="common_reset_all_confirm">Reset</string>

    <!--
      ============ Fetch from folder structure (DirMetaButton) ============
      User 2026-10-22: an icon button next to "Reset all adjustments" that refills
      **every** metadata field of the current volume from the folder structure only,
      bypassing ComicInfo.xml (whose values normally outrank folder-derived advice).
      Long press reveals `common_dir_meta_hint`; tapping asks for confirmation because
      it overwrites 7 fields at once and marks each as a per-volume exception.
    -->
    <string name="common_dir_meta_cd">Fetch metadata from folder structure</string>
    <string name="common_dir_meta_hint">Fetch metadata from folder structure</string>
    <string name="common_dir_meta_title">Fetch metadata from folder structure?</string>
    <string name="common_dir_meta_body">Title, series, writer, volume number and CBZ file name of this volume will be refilled from the folder names, replacing the current values.</string>
    <string name="common_dir_meta_confirm">Refill</string>

    <!-- ============ Scroll to top (ScrollToTopButton) ============ -->
    <string name="common_scroll_to_top">Back to top</string>

    <!--
      ============ Issue filter (IssueFilterRow) ============
      Shared by the naming table, the rename plan page and the execution report page —
      the three places where a long list can be narrowed down to "what needs my attention".
    -->
    <string name="common_filter_all">All</string>
    <string name="common_filter_all_cd">Show all</string>
    <string name="common_filter_issues">Issues only (%1$d)</string>
    <string name="common_filter_issues_cd">Show only items that need attention</string>
    <string name="common_filter_none">Nothing needs attention</string>

    <!-- ============ Pin toggle (PinToggle) ============ -->
    <string name="pin_toggle_pinned">%1$s is pinned</string>
    <string name="pin_toggle_unpinned">Pin %1$s</string>

    <!-- ============ Image preview (ImagePreview / PreviewState) ============ -->
    <string name="preview_no_images">No images to preview</string>
    <string name="preview_close_cd">Close preview</string>
    <string name="preview_hint">Double-tap to zoom · drag with two fingers to pan</string>
    <string name="preview_previous">Previous</string>
    <string name="preview_next">Next</string>
    <string name="preview_page_label">Page %1$d of %2$d</string>
    <string name="preview_zoom_cd">Zoom %1$s</string>
    <string name="preview_image_cd">Image %1$s</string>
    <string name="preview_rename">Rename</string>
    <string name="preview_rename_title">Rename image</string>
    <string name="preview_rename_field">New file name</string>
    <string name="preview_rename_hint">Leave empty to restore the suggested name.</string>
    <string name="preview_rename_save">Save</string>
    <string name="preview_renamed">Will be renamed to %1$s</string>

    <!-- ============ Workspace (D2a · SAF read-only) ============ -->
    <string name="workspace_current">Workspace: %1$s</string>
    <string name="workspace_current_cd">Current workspace %1$s, tap to manage folders</string>
    <string name="workspace_pick">Choose folder</string>
    <string name="workspace_pick_cd">Choose a folder to read images from</string>
    <!-- Ready 态右侧按钮打开的是**列表**而非系统选择器，所以不能叫「Change」。
         原来那两条「更换」文案键随本次改判一并删除：留着即 lint UnusedResources
         （warningsAsErrors = true 下是硬失败）。 -->
    <string name="workspace_button">Folders</string>
    <string name="workspace_button_cd">Manage workspace folders</string>
    <string name="workspace_loading">Scanning folder…</string>
    <string name="workspace_denied">Access to %1$s was revoked. Pick the folder again.</string>
    <!-- 自动重试过仍失败：与「一次没试就放弃」是两种信号，措辞要如实。 -->
    <string name="workspace_denied_retried">Still no access to %1$s after retrying. Pick the folder again.</string>
    <string name="workspace_denied_generic">Access was revoked. Pick the folder again.</string>
    <string name="workspace_failed">Could not read that folder. Pick it again or choose another one.</string>
    <string name="workspace_empty">This folder has no images</string>
    <string name="workspace_empty_hint">Pick another folder to organize.</string>
    <string name="workspace_demo_note">Showing demo data — choose a folder to work on real files</string>
    <!-- ============ Workspace list dialog (D4 · 最近 8 条 + 图钉 + 拖拽) ============ -->
    <string name="workspace_list_title">Workspace folders</string>
    <string name="workspace_section_granted">Persistent access</string>
    <string name="workspace_section_stale">Path remembered only</string>
    <string name="workspace_section_stale_hint">Tap to re-grant access.</string>
    <string name="workspace_list_add">Add folder…</string>
    <string name="workspace_in_use">In use</string>
    <string name="workspace_remove_cd">Remove %1$s from the list</string>
    <string name="workspace_release_switch">Also revoke system access</string>
    <string name="workspace_reject_all_pinned">All folders are pinned. Unpin one to add another.</string>

</resources>
