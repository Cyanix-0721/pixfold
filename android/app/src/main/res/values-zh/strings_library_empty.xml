<?xml version="1.0" encoding="utf-8"?>
<!--
  工作流 B · 工作区为空时的文案(中文)。

  ⚠️ 与默认文件 `values/strings_library_empty.xml` 必须同步增删 —— 缺一边会让 lint 的
  `MissingTranslation` / `ExtraTranslation` 在 `warningsAsErrors = true` 下硬失败。
-->
<resources>

    <!-- 两句是刻意的:第一句陈述事实,第二句给出下一步动作。不要压成一句「没有卷」——
         用户需要的是怎么办,不只是诊断。 -->
    <string name="b_meta_empty">这个工作区里没有可编辑的漫画卷。\n请选择一个包含图片文件夹的目录，或在文件管理器里添加图片后重试。</string>

    <!-- 步骤 1(漫画库列表)。刻意短:紧邻上方的工作区条已经带了「更换」按钮,
         这里再教一遍怎么换目录会让用户在两处找同一个入口。 -->
    <string name="b_library_empty">还没有扫描到漫画卷。\n每个「直接包含图片」的文件夹就是一卷。</string>

    <!-- 步骤 3 单独一条,不复用 `b_meta_empty`:本步的语义是打包,说「没有可编辑的卷」
         会让用户以为是不是点错了步骤。 -->
    <string name="b_pack_empty">这个工作区里没有可打包的漫画卷。\n请选择一个包含图片文件夹的目录，或在文件管理器里添加图片后重试。</string>

    <!-- 执行被阻断(D2b) -->
    <string name="pack_error_space">可用空间不足：还差 %1$s（当前可用 %2$s）。</string>

    <!-- 输出名撞车(2026-10-19 真机实测:同系列两本打成一个文件,报告说成功 2 本、
         磁盘只剩 1 个)。中文无单复数变化,只留 other 一档。 -->
    <plurals name="pack_error_collision">
        <item quantity="other">%1$d 卷写到了同一个文件：%2$s</item>
    </plurals>

    <string name="pack_error_collision_hint">请回到步骤 2 改掉其中一本的 CBZ 文件名，再试一次。</string>

    <string name="pack_error_unknown">打包被阻断，但原因未知。请反馈这个问题。</string>

    <!-- 上次打包被中断的提示（D2b 第 2 项）。刻意不说「已完成」也不说「失败」：
         中断时刻的真实状态不可知，说死了会误导用户去删可能完好的文件。 -->
    <string name="b_interrupted_dismiss">知道了</string>

    <!-- 已有打包任务在跑。并发写同一批输出路径会互相覆盖，故必须拒绝。 -->
    <string name="pack_error_busy">已有打包任务正在进行，请等它结束后再试。</string>

    <!-- 前台服务被系统超时回收（dataSync 类型有时长上限，Android 15+）。
         刻意说「可能没写完」而不是「失败」：系统在哪一刻掐断不可知，
         已写的卷可能是完整的。 -->
    <string name="pack_error_timeout">打包任务超出系统时限被中止，部分输出文件可能没写完。</string>

    <!-- 上次打包被中断（D2b 第 2 项）。三项读数：处理了几卷 / 共几卷 / 几个目标文件。 -->
    <string name="b_interrupted_notice">上次打包未完成（%1$d / %2$d）。可能没写完的输出文件：最多 %3$d 个。</string>
    <!-- ===== 计划页预检（D4b）===== -->

    <!-- 空间临界：够，但腾不出余量。与 pack_error_space（不足，阻断）语义相反。 -->
    <string name="pack_warn_space_marginal">可用空间紧张：只剩 %1$s，预计需要约 %2$s。</string>

    <!-- 估算只是下界：provider 没给某些文件的大小，实际可能更大。 -->
    <string name="pack_warn_estimate_lower_bound">估算只是下界（没有大小的项：%1$d）。</string>

    <!-- 需要 Zip64：仍能正常写出，是告知不是阻断。 -->
    <string name="pack_warn_zip64">这一卷需要 ZIP64：%1$s。仍会正常写出。</string>

    <string name="pack_warn_zip64_reason_entries">条目超过 65535 个</string>
    <string name="pack_warn_zip64_reason_entry_size">单个文件达到 4 GB 以上</string>
    <string name="pack_warn_zip64_reason_offset">整个包达到 4 GB 以上</string>

    <!-- 空间无法判定。刻意不说「充足」，那是假的承诺。 -->
    <string name="pack_warn_space_unknown">无法判断这个文件夹的可用空间。</string>
</resources>
