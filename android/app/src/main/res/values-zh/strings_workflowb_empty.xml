<?xml version="1.0" encoding="utf-8"?>
<!--
  工作流 B · 工作区为空时的文案(中文)。

  ⚠️ 与默认文件 `values/strings_workflowb_empty.xml` 必须同步增删 —— 缺一边会让 lint 的
  `MissingTranslation` / `ExtraTranslation` 在 `warningsAsErrors = true` 下硬失败。
-->
<resources>

    <!-- 两句是刻意的:第一句陈述事实,第二句给出下一步动作。不要压成一句「没有卷」——
         用户需要的是怎么办,不只是诊断。 -->
    <string name="b_meta_empty">这个工作区里没有可编辑的漫画卷。\n请选择一个包含图片文件夹的目录，或在文件管理器里添加图片后重试。</string>

    <!-- 步骤 1(漫画库列表)。刻意短:紧邻上方的工作区条已经带了「更换」按钮,
         这里再教一遍怎么换目录会让用户在两处找同一个入口。 -->
    <string name="b_library_empty">还没有扫描到漫画卷。\n每个「直接包含图片」的文件夹就是一卷。</string>

    <!-- 步骤 3 单独一条,不复用 `b_meta_empty`:本步的语义是打包,说「没有可编辑的卷」
         会让用户以为是不是点错了步骤。 -->
    <string name="b_pack_empty">这个工作区里没有可打包的漫画卷。\n请选择一个包含图片文件夹的目录，或在文件管理器里添加图片后重试。</string>

    <!-- 执行被阻断(D2b) -->
    <string name="pack_error_space">可用空间不足：还差 %1$s（当前可用 %2$s）。</string>

    <!-- 输出名撞车(2026-10-19 真机实测:同系列两本打成一个文件,报告说成功 2 本、
         磁盘只剩 1 个)。中文无单复数变化,只留 other 一档。 -->
    <plurals name="pack_error_collision">
        <item quantity="other">%1$d 卷写到了同一个文件：%2$s</item>
    </plurals>

    <string name="pack_error_collision_hint">请回到步骤 2 改掉其中一本的 CBZ 文件名，再试一次。</string>

    <string name="pack_error_unknown">打包被阻断，但原因未知。请反馈这个问题。</string>

</resources>
