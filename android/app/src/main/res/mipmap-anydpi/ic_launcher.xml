<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（三层：background 矢量渐变底色、foreground M3E 猫耳书图形、monochrome 单色主题蒙版）。

  **本文件无版本限定符**（2026-09-22 起）：自适应图标是 API 26 引入，而本模块不存在旧版兜底，
  保留无限定符目录即可避免 lint `ObsoleteSdkInt` / `UnnecessaryQualifier` 报错。

  三层含义：
    background  108dp 纯矢量底图，基础底色引用 @color/ic_launcher_background
                （自动随 values / values-night 两档亮暗切换）并叠加柔和 M3E 层次。
    foreground  图形本体（108dp 视口，核心元素收进中央 66dp 圆形安全区内）。
    monochrome  「主题化图标」开关：Android 13+ 跟随壁纸动态取色。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
