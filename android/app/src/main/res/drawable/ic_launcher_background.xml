<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层（108×108dp 纯矢量）：
  底色直接引用 @color/ic_launcher_background，使浅色系统底（#3F51B5）与深色系统底
  （values-night #1A237E）沿用既有双档语义，再叠加克制的 M3E 柔和径向与对角高光层次。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#26FFFFFF" />
                <item android:offset="0.55" android:color="#00FFFFFF" />
                <item android:offset="1.0" android:color="#1A0B1142" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="74"
                android:centerY="28"
                android:gradientRadius="64"
                android:startColor="#4D8C9EFF"
                android:endColor="#008C9EFF" />
        </aapt:attr>
    </path>
</vector>
