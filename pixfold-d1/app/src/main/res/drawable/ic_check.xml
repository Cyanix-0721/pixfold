<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Icons "done"(对勾)— 列数下拉菜单里**当前生效那一项**的 leadingIcon
  (用户 2026-09-26 裁决:「当前值只在下拉列表显示」)。

  素材来源:https://github.com/google/material-design-icons
            src/action/done/materialicons/24px.svg
  License: Apache License 2.0
  ⚠️ 路径写 `src/navigation/check/…` 取不到(实测 curl TLS eof / 空响应),
     官方对勾图标的实际目录是 `action/done`。

  官方 SVG 含两段 path:第一段 `M0 0h24v24H0z` 是 `fill="none"` 的全透明占位底,
  对 Android vector 毫无作用(不画任何像素),故只保留第二段实体对勾,免得读代码的人
  以为这里有两层图形。坐标本就是 24x24 正坐标,无需平移或缩放。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" />
</vector>
