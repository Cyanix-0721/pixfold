<?xml version="1.0" encoding="utf-8"?>
<!--
  工作流 A 页面文案(中文)。

  ⚠️ 与默认文件 `values/strings_workflowa.xml` 必须同步增删 —— 缺一边会让 lint 的
  `MissingTranslation` / `ExtraTranslation` 在 `warningsAsErrors = true` 下硬失败。
  `translatable="false"` 的条目在默认文件里,本文件不出现。

  命名:`a_sort_*` = 步骤 1 排序规则编辑器、`a_*` = 步骤 1/2/3 页面、
  `a_step_*` = 工作流 A 步骤容器。
-->
<resources
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 步骤 1 · 排序与预览(SortAndPreviewPage) ============ -->
    <string name="a_rule_scope_custom">本组独立规则</string>
    <string name="a_rule_scope_default">批次默认规则</string>
    <!--
      2026-09-26 用户裁决:「集合按钮内的字没有居中,集合名(数量)后面还有一块空格的感觉」。
      根因不是 padding(真机实测左右内衬各 56px = 16dp,**完全对称**),而是**全角括号的字形
      度量**:`（`/`）` 是 1em 宽的方块字形,墨迹只占 em 框的一侧,于是「旅行照片(30)」
      整体看上去右偏 + 尾部留白(同一根因的两个说法)。
      改成与 en 同一形态的半角括号 —— 字形紧贴文字,计数不再"飘"在右边。
      ⚠️ 全仓没有测试断言这个字面量(grep 只命中两份资源 + SortAndPreviewPage.kt 一处调用),
      但它是**数据格式**不是文案,改动须同步 `ChipFormatTest` 的守护断言。
    -->
    <string name="a_collection_chip">%1$s (%2$d)</string>
    <string name="a_collection_cd">集合 %1$s</string>
    <plurals name="a_image_count">
        <item quantity="other">共 %1$d 张</item>
    </plurals>
    <plurals name="a_manual_count">
        <item quantity="other">已手动调整 %1$d 处</item>
    </plurals>
    <string name="a_reset_manual_cd">重置人工调整</string>
    <!-- 同一处全角括号字形缺陷的邻居(见上条 a_collection_chip 注释):「重置人工调整(0 处)」
         尾部的全角 `）` 同样只占 em 框一侧。一并改为半角,避免同一行出现两种括号形态。 -->
    <string name="a_reset_manual">重置人工调整 (%1$d 处)</string>
    <string name="a_custom_rule">本组独立</string>
    <string name="a_custom_rule_cd">本组独立规则</string>
