<?xml version="1.0" encoding="utf-8"?>
<!--
  工作流 B 页面文案(中文)。

  ⚠️ 与默认文件 `values/strings_workflowb.xml` 必须同步增删 —— 缺一边会让 lint 的
  `MissingTranslation` / `ExtraTranslation` 在 `warningsAsErrors = true` 下硬失败。
  `translatable="false"` 的条目在默认文件里,本文件不出现。

  命名:`meta_*` = 步骤 2 元数据页、`pack_*` = 步骤 3 打包预览页、`lib_*` = 步骤 1 漫画库页、
  `b_*` = 工作流 B 步骤容器。
-->
<resources
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 步骤容器(WorkflowBSteps) ============ -->
