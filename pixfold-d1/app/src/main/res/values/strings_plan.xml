<?xml version="1.0" encoding="utf-8"?>
<!--
  Plan / report screen strings (English, default / fallback). Covers
  `ui/plan/PlanComponents.kt` and `ui/plan/ExecutionReportPage.kt`.

  Naming rule: each screen gets a pair `values/strings_<screen>.xml` +
  `values-zh/strings_<screen>.xml`, so parallel edits do not collide in one file.
  ⚠️ Both files must gain a key together, otherwise `MissingTranslation` /
  `ExtraTranslation` hard-fails under `warningsAsErrors = true`.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Plan header (PlanHeader) ============ -->
    <plurals name="plan_summary_title">
        <item quantity="one">%1$d volume · %2$d to run</item>
        <item quantity="other">%1$d volumes · %2$d to run</item>
    </plurals>
    <string name="plan_summary_skipped" tools:ignore="PluralsCandidate">\u0020· %1$d skipped</string>
    <string name="plan_no_danger">No dangerous action: source files are kept, nothing is deleted</string>
    <string name="plan_danger_action">⚠️ Dangerous action: %1$s (needs a separate confirmation before running)</string>
    <string name="plan_will_run">Will run</string>

    <!-- ============ Plan row (PlanRow) ============ -->
    <string name="plan_skip_reason_prefix">⛔ %1$s</string>

    <!-- ============ Confirmation dialog (ConfirmDialog) ============ -->
    <string name="plan_confirm_progress_cd">Step %1$d of %2$d</string>
    <string name="common_cancel">Cancel</string>

    <!-- ============ Execution report page (ExecutionReportPage) ============ -->
    <string name="report_undo">Undo this run</string>
    <string name="report_done">Done</string>
    <string name="report_empty">Nothing ran (the plan was empty)</string>
    <string name="report_nothing_to_undo">Nothing ran successfully, so there is nothing to undo</string>
    <string name="report_outcome_cd">Result: %1$s</string>
    <string name="report_reason">Reason: %1$s</string>

    <!-- ============ Undo scope warning (UndoScopeDialog) ============ -->
    <!-- 用户 2026-10-04(m04079 第③项):「添加警告，仅选择当前操作生成的撤销还是
         全部删除还是取消，记得按钮颜色要区分开，把取消放到最后边」。
         只有「本次覆盖了原本已存在的文件」时才弹这个框 —— 没有覆盖项时两种范围
         结果完全一样,弹框只是多一次无谓点击。 -->
    <string name="report_undo_warning_title">⚠️ Some files were already there and this run overwrote them</string>
    <plurals name="report_undo_warning_body">
        <item quantity="one">%1$d file was replaced. What it held before is already gone, so deleting it cannot be undone.</item>
        <item quantity="other">%1$d files were replaced. What they held before is already gone, so deleting them cannot be undone.</item>
    </plurals>
    <string name="report_undo_this_run">Undo only what this run created</string>
    <string name="report_undo_everything">Delete everything, overwritten included</string>

</resources>
